# Application
APP_NAME=Security AI


# PostgreSQL
POSTGRES_DB=security_ai
POSTGRES_USER=security_ai
POSTGRES_PASSWORD=replace-with-a-strong-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Used when running the Python application directly from Windows.
# Docker Compose overrides DATABASE_URL for containers so they use
# the internal "database" hostname.
DATABASE_URL=postgresql+psycopg://security_ai:replace-with-a-strong-development-password@localhost:5432/security_ai


# Authentication
# Must be at least 32 characters.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# AI investigation
# Supported values:
# disabled
# openai
AI_PROVIDER=disabled

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=30000


# Celery
# Used when running the API/worker directly from Windows.
# Docker Compose overrides this with redis://redis:6379/0.
CELERY_BROKER_URL=redis://localhost:6379/0


# Threat intelligence
# Supported values:
# disabled
# abuseipdb
THREAT_INTEL_PROVIDER=disabled

ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
ABUSEIPDB_MAX_AGE_DAYS=90

THREAT_INTEL_TIMEOUT_SECONDS=10
THREAT_INTEL_CACHE_TTL_HOURS=24